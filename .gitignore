# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# Ignore CSV files
*.csv

# Ignore Python bytecode
__pycache__/

# Ignore Claude Code local settings
.claude/
# Webcam timelapse frames (~1 GB) - labelled locally, too big to commit
files/weather/webcam/

# *.csv above is a blanket ignore, but these two are pipeline INPUTS that the
# NWP workflow reads out of the checkout, plus the 29-year undercast record
# itself. They have to be tracked or the Action has nothing to run against.
!files/weather/obs/nwp_sample.csv
!files/weather/obs/undercast_record.csv
!files/weather/csv/obs/*.csv

# Retrained undercast models: regenerable from the shard CSVs, and the
# RandomForest artifacts are large. Committing them is a CUTOVER decision --
# see scripts/README_undercast_pipeline.md -- not something to do incidentally.
files/weather/models/obs/*
# ...but keep the small JSON metrics. They are the provenance for the numbers
# quoted on /weather/details/ -- thresholds, per-lead AUC, rule baselines -- and
# cost a few hundred KB. The .pkl/.json model artifacts beside them are the
# large, regenerable part and stay ignored.
!files/weather/models/obs/model_metadata_*.json
!files/weather/models/obs/baseline_rules.json

# Narrow shards from a partial re-fetch (fetch_nwp_at_obs.py --models ...).
# Spliced into files/weather/csv/obs by merge_nwp_columns.py; never committed.
files/weather/csv/obs_partial/
